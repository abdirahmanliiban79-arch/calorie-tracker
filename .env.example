# Server
PORT=9997
NODE_ENV=development

# MongoDB connection strings (replace with your own credentials)
MONGO_URI_PRO=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?compressors=zlib
MONGO_URI_DEV=mongodb://localhost:27017/<dbname>

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2
R2_PUBLIC_URL=https://pub-<your-public-bucket-id>.r2.dev
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ACCOUNT_ID=your-cloudflare-account-id

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
